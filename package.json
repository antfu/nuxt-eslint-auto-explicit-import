{
  "name": "nuxt-eslint-auto-explicit-import",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@11.1.3",
  "description": "Auto insert explicit import from your Nuxt app",
  "license": "MIT",
  "repository": "antfu/nuxt-eslint-auto-explicit-import",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "prepare": "nuxt-module-build prepare",
    "build": "pnpm run prepack",
    "play": "nuxi dev playground",
    "play:build": "nuxi build playground",
    "play:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "bumpp",
    "lint": "eslint .",
    "lint:play": "pnpm -C playground run lint",
    "test": "vitest"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.6",
    "eslint-plugin-unimport": "^2.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@nuxt/devtools": "latest",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.6",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^25.9.1",
    "bumpp": "^11.1.0",
    "eslint": "^10.4.0",
    "nuxt": "^4.4.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
